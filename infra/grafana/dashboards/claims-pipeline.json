{
  "uid": "claims-pipeline",
  "title": "Claims Pipeline",
  "tags": [
    "claims"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Outbox backlog",
      "description": "Unpublished events. Sustained non-zero means the relay is not draining.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "relay_outbox_backlog",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Oldest unpublished event",
      "description": "Age in seconds. A small backlog that is not ageing is fine; an ageing one is stuck.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "relay_outbox_oldest_age_seconds",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Live WebSocket clients",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(claims_websocket_connections)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Mean publish latency",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(relay_publish_seconds_sum[5m]) / rate(relay_publish_seconds_count[5m])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Claims submitted by loss type",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum by (loss_type) (increase(claims_submitted_total[5m]))",
          "legendFormat": "{{loss_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Transitions by outcome",
      "description": "Accepted versus refused. A rising rejection rate means adjusters are attempting actions the state machine forbids.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum(increase(claims_transitions_total[5m]))",
          "legendFormat": "accepted",
          "refId": "A"
        },
        {
          "expr": "sum by (outcome) (increase(claims_transitions_rejected_total[5m]))",
          "legendFormat": "rejected: {{outcome}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "API request rate by status",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "API latency percentiles",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Login attempts",
      "description": "Failures far exceeding successes suggests credential stuffing.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "sum by (result) (increase(claims_login_attempts_total[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Events published by type",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "expr": "sum by (event_type) (increase(relay_events_published_total[5m]))",
          "legendFormat": "{{event_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "AI cost per claim",
      "description": "Total model spend divided by claims processed. The headline unit economic.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "expr": "ai_cost_per_claim_usd",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        }
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Total AI spend",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 28
      },
      "targets": [
        {
          "expr": "sum(ai_cost_usd)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        }
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Embedding cache hit ratio",
      "description": "Fraction of model calls served from cache rather than the API.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "expr": "ai_cache_hit_ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0
        }
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Claims processed",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 28
      },
      "targets": [
        {
          "expr": "ai_claims_processed",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "type": "piechart",
      "title": "Spend by operation",
      "description": "Where the money goes. Assessment reasoning dominates; embeddings are marginal.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum by (operation) (ai_cost_usd)",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        }
      }
    },
    {
      "id": 16,
      "type": "bargauge",
      "title": "Mean model latency by operation",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 32
      },
      "targets": [
        {
          "expr": "ai_latency_seconds_avg",
          "legendFormat": "{{service}} / {{operation}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2
        }
      }
    },
    {
      "id": 17,
      "type": "piechart",
      "title": "Coverage verdicts",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 32
      },
      "targets": [
        {
          "expr": "assessments_by_verdict",
          "legendFormat": "{{coverage_verdict}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 18,
      "type": "bargauge",
      "title": "Claims by status",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "expr": "claims_by_status",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 19,
      "type": "bargauge",
      "title": "Claims by risk band",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 40
      },
      "targets": [
        {
          "expr": "claims_by_risk_band",
          "legendFormat": "{{risk_band}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "type": "bargauge",
      "title": "Documents by pipeline state",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 40
      },
      "targets": [
        {
          "expr": "documents_by_processing_status",
          "legendFormat": "{{processing_status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Tokens consumed",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 47
      },
      "targets": [
        {
          "expr": "sum by (direction) (ai_tokens)",
          "legendFormat": "{{direction}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Model calls by outcome",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 47
      },
      "targets": [
        {
          "expr": "sum by (succeeded) (ai_calls)",
          "legendFormat": "succeeded={{succeeded}}",
          "refId": "A"
        }
      ]
    }
  ]
}